# Cloudinary configuration
# There are two ways the app can upload images to Cloudinary:
# 1) Server-side signed uploads (recommended): set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET below.
#    This keeps your API secret on the server and lets the server sign upload requests.
# 2) Unsigned uploads (client-side): create an unsigned upload preset in Cloudinary and set NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
#    and NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET. This allows direct browser uploads without exposing your API secret but is less secure.

# Server-side (recommended)
CLOUDINARY_CLOUD_NAME= dvxpdh49p
CLOUDINARY_API_KEY= 642734946836584
CLOUDINARY_API_SECRET= 6y3Np2Yc1wLYAh30K7TtiGoQXws

# Unsigned client-side preset (optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME= 
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Notes:
# - After copying this file to .env.local and filling the values, restart the dev server.
# - If you set CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET, the admin UI will POST resized images to
#   /api/admin/upload-image which will securely forward the upload to Cloudinary and return the hosted URL.
# - If you prefer client-side unsigned uploads, set NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME and
#   NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET (and you can leave CLOUDINARY_API_SECRET blank).

# Example usage:
# cp .env.local.template .env.local
# Edit .env.local and fill real values before running `npm run dev`.
